@page
@model Movie.Web.Pages.MovieDetailsModel
@{
    ViewData["Title"] = Model.Movie.Title;
}
<div class="container mt-4">
    <div class="card shadow">
        <div class="card-body">
            <h2>@Model.Movie.Title</h2>
            <hr />
            <p><strong>Studio:</strong> @Model.Movie.StudioName</p>
            <p><strong>Release Year:</strong> @Model.Movie.ReleaseYear</p>
            <div class="mt-3">
                <strong>Actors:</strong>
                <ul class="list-group list-group-flush mt-2">
                    @foreach (var actor in Model.Movie.ActorName)
                    {
                        <li class="list-group-item">@actor</li>
                    }
                </ul>
            </div>
            <a asp-page="/MoviePage" class="btn btn-secondary mt-3">Back</a>
        </div>
    </div>
</div>